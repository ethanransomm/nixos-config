{
  // ── REPLACE WITH YOUR EXISTING fastfetch config.jsonc ──
  // Paste your backed-up ~/.config/fastfetch/config.jsonc here (the one from
  // our earlier chat with the Hardware box and arch logo). It'll be symlinked
  // into place and used exactly as-is.
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": { "type": "auto", "source": "nixos" },
  "modules": [ "title", "separator", "os", "kernel", "cpu", "gpu", "memory", "disk" ]
}
